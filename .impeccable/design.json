      "html": "<a class=\"ds-text-link\" href=\"#xssscope\">Telusuri xssscope <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-text-link{display:inline-flex;align-items:center;gap:22px;min-height:44px;border-bottom:1px solid var(--site-metal,#725739);padding:9px 0;font:14px Inter,sans-serif;color:var(--site-ink,#10272e);text-decoration:none;transition:color .18s,gap .18s}.ds-text-link:hover{color:var(--site-metal,#725739);gap:29px}.ds-text-link svg{width:19px;height:19px;flex:none}.ds-text-link:focus-visible{outline:2px solid var(--site-metal,#725739);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-text-link{transition:none}}"
    },
    {
      "name": "Submit Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled form action with brightness hover and disabled feedback.",
      "html": "<button type=\"button\" class=\"ds-submit\">Kirim pesan <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg></button>",
      "css": ".ds-submit{min-height:48px;padding:10px 22px;display:inline-flex;align-items:center;justify-content:center;gap:22px;background:var(--site-metal,#725739);color:var(--site-bg,#f1ece1);border:0;border-radius:3px;font:14px Inter,sans-serif;cursor:pointer;transition:filter .18s}.ds-submit:hover{filter:brightness(1.1)}.ds-submit:disabled{opacity:.55;cursor:not-allowed}.ds-submit svg{width:18px;height:18px}.ds-submit:focus-visible{outline:2px solid var(--site-metal,#725739);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-submit{transition:none}}"
    },
    {
      "name": "Contact Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and transparent input with a reserved validation/count line.",
      "html": "<div class=\"ds-field\"><label for=\"ds-contact-name\">Nama</label><input id=\"ds-contact-name\" name=\"name\" placeholder=\"Nama lengkapmu\" aria-describedby=\"ds-name-info\" maxlength=\"50\"/><div class=\"ds-field-info\" id=\"ds-name-info\"><span></span><span>0/50</span></div></div>",
      "css": ".ds-field{display:grid;gap:9px;color:var(--site-ink,#10272e);font-family:Inter,sans-serif}.ds-field label{font-size:13px;font-weight:500}.ds-field input{width:100%;border:1px solid var(--site-input,#8a8274);padding:13px 15px;border-radius:3px;background:transparent;color:var(--site-ink,#10272e);font:16px Inter,sans-serif;caret-color:var(--site-metal,#725739)}.ds-field input::placeholder{color:var(--site-muted,#536568)}.ds-field input[aria-invalid=true]{border-color:hsl(var(--destructive,4 66% 39%))}.ds-field input:focus-visible{outline:2px solid var(--site-metal,#725739);outline-offset:5px;}.ds-field-info{display:flex;justify-content:space-between;gap:12px;min-height:20px;font-size:12px;color:var(--site-muted,#536568)}"
    },
    {
      "name": "Public Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Official mark, full name and ruled active state from the public desktop shell.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi utama\"><a class=\"ds-brand\" href=\"#beranda\"><svg viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M144 176L144 160L176 160L176 144L128 144L128 112L144 112L144 32L224 32L224 224L144 224L144 208L176 208L176 176Z M32 32L96 32L96 96L128 96L128 112L96 112L96 144L128 144L128 176L144 176L144 208L96 208L96 224L32 224Z\"/></svg><span>Rifqi Ariansyah</span></a><div class=\"ds-nav-links\"><a href=\"#beranda\">Beranda</a><a href=\"#karya\" aria-current=\"page\">Karya</a><a href=\"#tentang\">Tentang</a><a href=\"#kontak\">Kontak</a></div></nav>",
      "css": ".ds-nav{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:24px;background:var(--site-bg,#f1ece1);border-bottom:1px solid var(--site-line,#c9c3b4);font-family:Inter,sans-serif}.ds-brand{display:inline-flex;align-items:center;gap:11px;min-height:44px;font-size:13px;font-weight:500;white-space:nowrap;color:var(--site-ink,#10272e);text-decoration:none}.ds-brand svg{width:28px;height:28px;color:var(--site-metal,#725739);flex:none}.ds-nav-links{display:flex;align-items:center;flex-wrap:wrap;gap:28px;font-size:12px}.ds-nav-links a{min-height:44px;display:inline-flex;align-items:center;color:var(--site-muted,#536568);text-decoration:none;transition:color .18s}.ds-nav-links a:hover,.ds-nav-links a[aria-current]{color:var(--site-metal,#725739)}.ds-nav-links a[aria-current]{text-decoration:underline;text-underline-offset:8px}.ds-nav a:focus-visible{outline:2px solid var(--site-metal,#725739);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-nav-links a{transition:none}}"
    },
    {
      "name": "Category Filter",
      "kind": "chip",
      "refersTo": "filter",
      "description": "Wrapping text filter; the selected state uses metal color and an underline.",
      "html": "<div class=\"ds-filter\" role=\"group\" aria-label=\"Filter kategori proyek\"><button type=\"button\" aria-pressed=\"true\">Semua karya</button><button type=\"button\" aria-pressed=\"false\">Security Tools</button><button type=\"button\" aria-pressed=\"false\">Web Security</button><button type=\"button\" aria-pressed=\"false\">Penetration Testing</button></div>",
      "css": ".ds-filter{display:flex;flex-wrap:wrap;gap:12px 28px;padding-bottom:22px;border-bottom:1px solid var(--site-line,#c9c3b4)}.ds-filter button{min-height:44px;color:var(--site-muted,#536568);background:transparent;border:0;border-bottom:1px solid transparent;font:13px Inter,sans-serif;cursor:pointer}.ds-filter button[aria-pressed=true]{color:var(--site-metal,#725739);border-bottom-color:var(--site-metal,#725739)}.ds-filter button:focus-visible{outline:2px solid var(--site-metal,#725739);outline-offset:5px;}"
    },
    {
      "name": "Process Artwork",
