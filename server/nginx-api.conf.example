# Include inside the existing rifqi.apexsions.com server block at full release cutover.
# Keep the current server-level security headers. Do not add this to other sites.
location ^~ /api/ {
    proxy_pass http://127.0.0.1:8788;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite an untrusted incoming chain; API trusts only its Docker gateway.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 70s;
    client_max_body_size 11m;
}
